FROM ghcr.io/open-webui/open-webui:main

USER root

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        composer \
        curl \
        git \
        nodejs \
        npm \
        php-bcmath \
        php-cli \
        php-curl \
        php-gd \
        php-intl \
        php-mbstring \
        php-pgsql \
        php-sqlite3 \
        php-xml \
        php-zip \
        unzip \
        zip \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*
